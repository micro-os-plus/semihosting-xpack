{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "micro-os-plus.semihosting",
      "display": "Portable Arm Semihosting",
      "description": "Define the Arm semihosting call numbers and API",
      "publicIncludeFolders": [
        "include"
      ],
      // TODO: remove them from here and process inner components.
      "sourceFiles": [],
      "dependencies": [
        "micro-os-plus.diag.trace",
        "micro-os-plus.diag.trace.semihosting",
        "micro-os-plus.architecture"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/semihosting-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_ENABLED",
      "cdlComponents": [
        {
          "id": "startup",
          "display": "Semihosting startup",
          "description": "Get the command line arguments via SYS_GETCMDLINE and parse them as for main(arc, argv); pass the return code back to the debugger when the application terminates",
          "publicIncludeFolders": [],
          "sourceFiles": [
            "src/semihosting-startup.cpp"
          ],
          "dependencies": [],
          // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_STARTUP_ENABLED",
          "cdlOptions": [
            {
              "id": "cmdline-buffer-array-size",
              "display": "Command line buffer array size",
              "description": "The maximum number of characters that can be received from the host; the buffer is modified in place, and space characters are replaced by nulls to mark the string terminators",
              "type": "integer",
              "defaultValue": 80,
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_STARTUP_CMDLINE_BUFFER_ARRAY_SIZE_INTEGER"
            },
            {
              "id": "argv-buffer-array-size",
              "display": "Argv buffer array size",
              "description": "The maximum number of arguments (pointers to strings) that can be passed as argv[] to main()",
              "type": "integer",
              "defaultValue": 10,
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_STARTUP_ARGV_BUFFER_ARRAY_SIZE_INTEGER"
            },
            {
              "id": "heapinfo",
              "display": "Heap info",
              "description": "Show information about the semihosting heap and stack",
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_STARTUP_HEAPINFO_ENABLED"
            }
          ]
        },
        {
          "id": "syscalls",
          "display": "Semihosting syscalls",
          "description": "Implement all POSIX functions over the Arm semihosting API; it complements the newlib implementation and adds debugging support",
          "publicIncludeFolders": [],
          "sourceFiles": [
            "src/semihosting-syscalls.cpp"
          ],
          "dependencies": [],
          // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_ENABLED",
          "cdlOptions": [
            {
              "id": "max-open-files",
              "display": "Max open files",
              "description": "The maximum number of files that can be simultaneously opened (the size of the statically allocated array storing the status of each opened file, i.e. an integer and offset); the first 3 entries are used for STDIN, STDOUT and STDERR.",
              "type": "integer",
              "defaultValue": 20,
              "legalValues": [
                "4 to 100"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_MAX_OPEN_FILES_INTEGER"
            },
            {
              "id": "debug-brk",
              "display": "Debug syscalls BRK",
              "description": "Enable debugging for all syscalls BRK",
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_BRK_ENABLED"
            },
            {
              "id": "debug-chdir-brk",
              "display": "Debug syscall chdir() BRK",
              "description": "Enable debugging for the chdir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_CHDIR_BRK_ENABLED"
            },
            {
              "id": "debug-chmod-brk",
              "display": "Debug syscall chmod() BRK",
              "description": "Enable debugging for the chmod() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_CHMOD_BRK_ENABLED"
            },
            {
              "id": "debug-chown-brk",
              "display": "Debug syscall chown() BRK",
              "description": "Enable debugging for the chown() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_CHOWN_BRK_ENABLED"
            },
            {
              "id": "debug-closedir-brk",
              "display": "Debug syscall closedir() BRK",
              "description": "Enable debugging for the closedir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_CLOSEDIR_BRK_ENABLED"
            },
            {
              "id": "debug-execve-brk",
              "display": "Debug syscall execve() BRK",
              "description": "Enable debugging for the execve() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_EXECVE_BRK_ENABLED"
            },
            {
              "id": "debug-fcntl-brk",
              "display": "Debug syscall fcntl() BRK",
              "description": "Enable debugging for the fcntl() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_FCNTL_BRK_ENABLED"
            },
            {
              "id": "debug-fork-brk",
              "display": "Debug syscall fork() BRK",
              "description": "Enable debugging for the fork() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_FORK_BRK_ENABLED"
            },
            {
              "id": "debug-fsync-brk",
              "display": "Debug syscall fsync() BRK",
              "description": "Enable debugging for the fsync() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_FSYNC_BRK_ENABLED"
            },
            {
              "id": "debug-ftruncate-brk",
              "display": "Debug syscall ftruncate() BRK",
              "description": "Enable debugging for the ftruncate() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_FTRUNCATE_BRK_ENABLED"
            },
            {
              "id": "debug-ioctl-brk",
              "display": "Debug syscall ioctl() BRK",
              "description": "Enable debugging for the ioctl() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_IOCTL_BRK_ENABLED"
            },
            {
              "id": "debug-kill-brk",
              "display": "Debug syscall kill() BRK",
              "description": "Enable debugging for the kill() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_KILL_BRK_ENABLED"
            },
            {
              "id": "debug-link-brk",
              "display": "Debug syscall link() BRK",
              "description": "Enable debugging for the link() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_LINK_BRK_ENABLED"
            },
            {
              "id": "debug-opendir-brk",
              "display": "Debug syscall opendir() BRK",
              "description": "Enable debugging for the opendir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_OPENDIR_BRK_ENABLED"
            },
            {
              "id": "debug-raise-brk",
              "display": "Debug syscall raise() BRK",
              "description": "Enable debugging for the raise() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_RAISE_BRK_ENABLED"
            },
            {
              "id": "debug-readdir-brk",
              "display": "Debug syscall readdir() BRK",
              "description": "Enable debugging for the readdir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_READDIR_BRK_ENABLED"
            },
            {
              "id": "debug-readlink-brk",
              "display": "Debug syscall readlink() BRK",
              "description": "Enable debugging for the readlink() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_READLINK_BRK_ENABLED"
            },
            {
              "id": "debug-rewinddir-brk",
              "display": "Debug syscall rewinddir() BRK",
              "description": "Enable debugging for the rewinddir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_REWINDDIR_BRK_ENABLED"
            },
            {
              "id": "debug-rmdir-brk",
              "display": "Debug syscall rmdir() BRK",
              "description": "Enable debugging for the rmdir() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_RMDIR_BRK_ENABLED"
            },
            {
              "id": "debug-select-brk",
              "display": "Debug syscall select() BRK",
              "description": "Enable debugging for the select() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_SELECT_BRK_ENABLED"
            },
            {
              "id": "debug-symlink-brk",
              "display": "Debug syscall symlink() BRK",
              "description": "Enable debugging for the symlink() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_SYMLINK_BRK_ENABLED"
            },
            {
              "id": "debug-sync-brk",
              "display": "Debug syscall sync() BRK",
              "description": "Enable debugging for the sync() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_SYNC_BRK_ENABLED"
            },
            {
              "id": "debug-truncate-brk",
              "display": "Debug syscall truncate() BRK",
              "description": "Enable debugging for the truncate() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_TRUNCATE_BRK_ENABLED"
            },
            {
              "id": "debug-utime-brk",
              "display": "Debug syscall utime() BRK",
              "description": "Enable debugging for the utime() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_UTIME_BRK_ENABLED"
            },
            {
              "id": "debug-wait-brk",
              "display": "Debug syscall wait() BRK",
              "description": "Enable debugging for the wait() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_WAIT_BRK_ENABLED"
            },
            {
              "id": "debug-writev-brk",
              "display": "Debug syscall writev() BRK",
              "description": "Enable debugging for the writev() syscall BRK",
              "activeIf": [
                "!debug-brk"
              ],
              // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_SYSCALLS_DEBUG_WRITEV_BRK_ENABLED"
            }
          ]
        },
      ],
      "cdlOptions": [
        {
          "id": "debug-faults",
          "display": "Debug faults",
          "description": "Enable debugging for the semihosting trace channel faults",
          // "defaultDefine": "MICRO_OS_PLUS_SEMIHOSTING_DEBUG_FAULTS_ENABLED"
        }
      ]
    },
    {
      "id": "micro-os-plus.diag.trace.semihosting",
      "display": "Diagnostics trace over semihosting",
      "description": "The semihosting trace::printf() implementation",
      "publicIncludeFolders": [],
      "sourceFiles": [
        "src/diag/trace-semihosting.cpp"
      ],
      // Requires isEnabled('semihosting').
      "dependencies": [
        "micro-os-plus.diag.trace"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_ENABLED",
      "cdlComponents": [
        {
          "id": "debug",
          "display": "Trace via semihosting debug",
          "description": "A diag trace channel implemented over the semihosting SYS_WRITE0 call",
          "implements": [
            "diag.trace.output-channel"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_DEBUG_ENABLED",
          "cdlOptions": [
            {
              "id": "buffer-array-size",
              "display": "Semihosting trace buffer array size",
              "description": "The size of a local buffer allocated on the stack, used to speed up the display",
              "type": "integer",
              "defaultValue": 16,
              // Keep this in sync with xcdl-package.jsonc definition.
              // "defaultDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_DEBUG_BUFFER_ARRAY_SIZE_INTEGER"
            }
          ]
        },
        {
          "id": "stdout",
          "display": "Trace via semihosting stdout",
          "description": "A diag trace channel implemented over the semihosting SYS_WRITE call on STDOUT",
          "implements": [
            "micro-os-plus.diag.trace.interface"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_STDOUT_ENABLED"
        }
      ]
    }
  ]
}