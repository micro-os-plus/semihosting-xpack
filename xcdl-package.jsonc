{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "micro-os-plus.semihosting",
      "display": "Portable Arm Semihosting",
      "description": "Define the Arm semihosting call numbers and API",
      "publicIncludeFolders": [
        "include"
      ],
      // TODO: remove them from here and process inner components.
      "sourceFiles": [],
      "dependencies": [
        "micro-os-plus.diag.trace",
        "micro-os-plus.architecture"
      ],
      // "$customDefine": "MICRO_OS_PLUS_INCLUDE_SEMIHOSTING",
      "cdlComponents": [
        {
          "id": "startup",
          "display": "Semihosting startup",
          "description": "Get the command line arguments via SYS_GETCMDLINE and parse them as for main(arc, argv); pass the return code back to the debugger when the application terminates",
          "publicIncludeFolders": [],
          "sourceFiles": [
            "src/semihosting-startup.cpp"
          ],
          "dependencies": [],
          "$customDefine": "MICRO_OS_PLUS_INCLUDE_SEMIHOSTING_STARTUP",
          "cdlOptions": [
            {
              "id": "args-buffer-array-size",
              "description": "The maximum number of characters that can be received from the host; the buffer is modified in place, and space characters are replaced by nulls to mark the string terminators",
              "type": "integer",
              "defaultValue": 80,
              // "customDefine": "MICRO_OS_PLUS_INTEGER_SEMIHOSTING_CMDLINE_ARRAY_SIZE"
            },
            {
              "id": "argv-buffer-array-size",
              "description": "The maximum number of arguments (pointers to strings) that can be passed as argv[] to main()",
              "type": "integer",
              "defaultValue": 10,
              // "customDefine": "MICRO_OS_PLUS_INTEGER_SEMIHOSTING_ARGV_ARRAY_SIZE"
            }
          ]
        },
        {
          "id": "syscalls",
          "display": "Semihosting syscalls",
          "description": "Implement all POSIX functions over the Arm semihosting API; it complements the newlib implementation and adds debugging support",
          "publicIncludeFolders": [],
          "sourceFiles": [
            "src/semihosting-syscalls.cpp"
          ],
          "dependencies": [],
          "cdlOptions": [
            {
              "id": "max-open-files",
              "display": "Max open files",
              "description": "The maximum number of files that can be simultaneously opened (the size of the statically allocated array storing the status of each opened file, i.e. an integer and offset); the first 3 entries are used for STDIN, STDOUT and STDERR.",
              "type": "integer",
              "defaultValue": 20,
              "legalValues": [
                "4 to 100"
              ],
              // "customDefine": "MICRO_OS_PLUS_INTEGER_SEMIHOSTING_MAX_OPEN_FILES"
            },
            {
              "id": "debug-syscalls-brk",
              "display": "Debug syscalls BRK",
              "description": "Enable debugging for all syscalls BRK",
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALLS_BRK"
            },
            {
              "id": "debug-syscall-chdir-brk",
              "display": "Debug syscall chdir() BRK",
              "description": "Enable debugging for the chdir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_CHDIR_BRK"
            },
            {
              "id": "debug-syscall-chmod-brk",
              "display": "Debug syscall chmod() BRK",
              "description": "Enable debugging for the chmod() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_CHMOD_BRK"
            },
            {
              "id": "debug-syscall-chown-brk",
              "display": "Debug syscall chown() BRK",
              "description": "Enable debugging for the chown() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_CHOWN_BRK"
            },
            {
              "id": "debug-syscall-closedir-brk",
              "display": "Debug syscall closedir() BRK",
              "description": "Enable debugging for the closedir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_CLOSEDIR_BRK"
            },
            {
              "id": "debug-syscall-execve-brk",
              "display": "Debug syscall execve() BRK",
              "description": "Enable debugging for the execve() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_EXECVE_BRK"
            },
            {
              "id": "debug-syscall-fcntl-brk",
              "display": "Debug syscall fcntl() BRK",
              "description": "Enable debugging for the fcntl() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_FCNTL_BRK"
            },
            {
              "id": "debug-syscall-fork-brk",
              "display": "Debug syscall fork() BRK",
              "description": "Enable debugging for the fork() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_FORK_BRK"
            },
            {
              "id": "debug-syscall-fsync-brk",
              "display": "Debug syscall fsync() BRK",
              "description": "Enable debugging for the fsync() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_FSYNC_BRK"
            },
            {
              "id": "debug-syscall-ftruncate-brk",
              "display": "Debug syscall ftruncate() BRK",
              "description": "Enable debugging for the ftruncate() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_FTRUNCATE_BRK"
            },
            {
              "id": "debug-syscall-ioctl-brk",
              "display": "Debug syscall ioctl() BRK",
              "description": "Enable debugging for the ioctl() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_IOCTL_BRK"
            },
            {
              "id": "debug-syscall-kill-brk",
              "display": "Debug syscall kill() BRK",
              "description": "Enable debugging for the kill() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_KILL_BRK"
            },
            {
              "id": "debug-syscall-link-brk",
              "display": "Debug syscall link() BRK",
              "description": "Enable debugging for the link() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_LINK_BRK"
            },
            {
              "id": "debug-syscall-opendir-brk",
              "display": "Debug syscall opendir() BRK",
              "description": "Enable debugging for the opendir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_OPENDIR_BRK"
            },
            {
              "id": "debug-syscall-raise-brk",
              "display": "Debug syscall raise() BRK",
              "description": "Enable debugging for the raise() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_RAISE_BRK"
            },
            {
              "id": "debug-syscall-readdir-brk",
              "display": "Debug syscall readdir() BRK",
              "description": "Enable debugging for the readdir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_READDIR_BRK"
            },
            {
              "id": "debug-syscall-readlink-brk",
              "display": "Debug syscall readlink() BRK",
              "description": "Enable debugging for the readlink() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_READLINK_BRK"
            },
            {
              "id": "debug-syscall-rewinddir-brk",
              "display": "Debug syscall rewinddir() BRK",
              "description": "Enable debugging for the rewinddir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_REWINDDIR_BRK"
            },
            {
              "id": "debug-syscall-rmdir-brk",
              "display": "Debug syscall rmdir() BRK",
              "description": "Enable debugging for the rmdir() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_RMDIR_BRK"
            },
            {
              "id": "debug-syscall-select-brk",
              "display": "Debug syscall select() BRK",
              "description": "Enable debugging for the select() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_SELECT_BRK"
            },
            {
              "id": "debug-syscall-symlink-brk",
              "display": "Debug syscall symlink() BRK",
              "description": "Enable debugging for the symlink() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_SYMLINK_BRK"
            },
            {
              "id": "debug-syscall-sync-brk",
              "display": "Debug syscall sync() BRK",
              "description": "Enable debugging for the sync() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_SYNC_BRK"
            },
            {
              "id": "debug-syscall-truncate-brk",
              "display": "Debug syscall truncate() BRK",
              "description": "Enable debugging for the truncate() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_TRUNCATE_BRK"
            },
            {
              "id": "debug-syscall-utime-brk",
              "display": "Debug syscall utime() BRK",
              "description": "Enable debugging for the utime() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_UTIME_BRK"
            },
            {
              "id": "debug-syscall-wait-brk",
              "display": "Debug syscall wait() BRK",
              "description": "Enable debugging for the wait() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_WAIT_BRK"
            },
            {
              "id": "debug-syscall-writev-brk",
              "display": "Debug syscall writev() BRK",
              "description": "Enable debugging for the writev() syscall BRK",
              "activeIf": [
                "!debugSyscallsBrk"
              ],
              // "customDefine": "MICRO_OS_PLUS_DEBUG_SYSCALL_WRITEV_BRK"
            }
          ]
        },
        {
          "id": "trace",
          "display": "Semihosting trace",
          "description": "Implement the diag trace chanel via semihosting",
          "publicIncludeFolders": [],
          "sourceFiles": [
            "src/diag/trace-semihosting.cpp"
          ],
          "dependencies": [
            "micro-os-plus.diag.trace"
          ],
          "cdlComponents": [
            {
              "id": "debug",
              "display": "Trace via semihosting debug",
              "description": "A diag trace channel implemented over the semihosting SYS_WRITE0 call",
              "implements": [
                "micro-os-plus.diag.trace.interface"
              ],
              // "customDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_DEBUG_ENABLED",
              "cdlOptions": [
                {
                  "name": "buffer-array-size",
                  "display": "Semihosting trace buffer array size",
                  "description": "The size of a local buffer allocated on the stack, used to speed up the display",
                  "type": "integer",
                  "defaultValue": 16,
                  // "customDefine": "MICRO_OS_PLUS_INTEGER_TRACE_SEMIHOSTING_BUFFER_ARRAY_SIZE"
                }
              ]
            },
            {
              "id": "stdout",
              "display": "Trace via semihosting stdout",
              "description": "A diag trace channel implemented over the semihosting SYS_WRITE call on STDOUT",
              "implements": [
                "micro-os-plus.diag.trace.interface"
              ],
              // "customDefine": "MICRO_OS_PLUS_DIAG_TRACE_SEMIHOSTING_STDOUT_ENABLED"
            }
          ]
        }
      ],
      "cdlOptions": [
        {
          "id": "debug-faults",
          "display": "Debug faults",
          "description": "Enable debugging for the semihosting trace channel faults",
          // "customDefine": "MICRO_OS_PLUS_SEMIHOSTING_DEBUG_FAULTS"
        }
      ]
    }
  ]
}